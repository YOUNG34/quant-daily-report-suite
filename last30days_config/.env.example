# last30days skill configuration template
# https://github.com/mvanhorn/last30days-skill
# Copy values from the docs. Empty lines / comments are OK.
# Setup: place this at $HOME/.config/last30days/.env (Linux) or
#        $HOME/.config/last30days/.env (macOS)
#        Then `chmod 600 ~/.config/last30days/.env`

# === X / Twitter (需要浏览器 cookie) ===
# 1. 用浏览器登录 x.com
# 2. F12 -> Application -> Storage -> Cookies -> https://x.com
# 3. 复制 auth_token -> AUTH_TOKEN
# 4. 复制 ct0 -> CT0
# 注意: cookie 几个月会过期, 失败就重新拿
AUTH_TOKEN=*** CT0=xxx
REDDIT_CLIENT_ID=xxx
REDDIT_CLIENT_SECRET=*** BSKY_HANDLE=you.bsky.social
BSKY_APP_PASSWORD=xxx-xxx-xxx-xxx
SCRAPECREATORS_API_KEY=***
OPENAI_API_KEY=***
XAI_API_KEY=***
OPENROUTER_API_KEY=***
BRAVE_API_KEY=***
EXA_API_KEY=***
SERPER_API_KEY=***
PARALLEL_API_KEY=***
