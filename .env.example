# ============================================================
# A股量化日报自动化套件 — 环境变量模板
# ============================================================
# 用法:
#   1. cp .env.example .env
#   2. 编辑填入真实值(API key, webhook URL, 路径覆盖等)
#   3. chmod 600 .env  (防止 token 泄漏)
# ============================================================

# ── 1. 知识库路径覆盖 ────────────────────────────
# 默认派生:$HOME/Projects/$QUANT_KB_NAME/Agent/quant/{dailyRepo,llm_signals}
# 如需自定义完整路径,直接设 QUANT_KB_DIR 覆盖派生逻辑
QUANT_KB_NAME=<your-knowledge-base>
# QUANT_PROJECTS=$HOME/Projects
# QUANT_KB_DIR=/custom/path/to/kb_root

# ── 2. LLM 凭据 (信号提取 + 公告摘要) ──────────────
# llm_signal_extractor.py 从这里读,通常指向 daily_stock_analysis 的 .env
# 如直接放在本仓库 .env,设 DSA_ENV_FILE 指向本文件
ANTHROPIC_API_KEY=sk-your-llm-api-key-here
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
LITELLM_MODEL=volcengine/doubao-seed-1-6-250615

# 走外部 .env(可选,推荐)— 把凭据集中到 daily_stock_analysis
# DSA_ENV_FILE=$HOME/Projects/daily_stock_analysis/.env

# ── 3. Python 解释器路径(可选)─────────────────────
# paper_trader/trader.py subprocess 调用时,显式指定 python
# PYTHON_BIN=/Users/<user>/Projects/quant-daily-report-suite/.venv/bin/python3

# ── 4. Discord 投递(可选,默认走 hermes cron)──────
# 用于报告手动推送到 Discord channel(非主路径)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ── 5. Telegram 投递(可选)─────────────────────
# 用于报告手动推送到 TG bot(非主路径)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=-1001234567890

# ── 6. 调试开关 ─────────────────────────────────
# 设 1 = 启用 DEBUG 日志
# DEBUG=1
# 设 1 = 跳过实际网络请求(适合本地 dry-run)
# DRY_RUN=1

# ── 7. 时区 ─────────────────────────────────────
# 默认 Asia/Shanghai,通常不用改
# TZ=Asia/Shanghai

# ── 8. Qlib 数据路径(可选)────────────────────────
# quant_core/paths.py 已默认设到 ~/.hermes/profiles/quant/home/.qlib/...
# 如自定义,覆盖:
# QLIB_DATA=/custom/path/to/qlib_data/baostock_cn

# ── 9. Pipeline 输出 ─────────────────────────────
# quant 选股流水线输出根目录(qlib_model.pkl / signals/ 等)
# PIPELINE_OUTPUT=$HOME/Projects/pipeline_output
